# Продакшен-сборка (npm run build) для выкладки на vue.cabrioride.by/app.
# Backend (PHP-код скопирован из Cabrio_app/backend) теперь лежит в этом же проекте
# и деплоится вместе с фронтендом в ту же папку на сервере — значит, это тот же домен,
# CORS не нужен. На сервере в backend/.env (не в git!) должна стоять тестовая БД
# host1708875_cabrioridedev и тестовый бот, как раньше на dev.cabrioride.by.
VITE_API_URL=https://vue.cabrioride.by/app/backend
