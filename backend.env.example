# CabrioRide — пример файла окружения (.env)
# Скопируйте этот файл как ".env" и заполните значениями.
# Внимание: файл .env должен быть в .gitignore и не попадать в репозиторий.

# Базовые URL
# На каждой среде свой .env и свои адреса (см. docs/ENVIRONMENTS.md):
#   бой:  https://cabrioride.by/app
#   тест: https://dev.cabrioride.by/app
#   локально: http://localhost/Cabrio_app  (пути /app/ в коде рассчитаны на хостинг)
BASE_URL=https://example.com/app
BACKEND_API_URL=https://example.com/app/backend/api.php

# База данных (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cabrio
DB_USER=cabrio_user
DB_PASSWORD=change_me

# Безопасность / интеграции
SYSTEM_TOKEN=change_me
BOT_SECRET=change_me
BOT_TOKEN=change_me
CHAT_INVITE_LINK=https://t.me/Cabrio_Ride
# Бой: https://cabrioride.by/app/frontend/
# Тест: https://dev.cabrioride.by/app/frontend/
APP_URL=https://cabrioride.by/app/frontend/

# Режим: production = без подробных логов API
APP_ENV=production
DEBUG=false
APP_DEBUG=false

# Яндекс.Карты
map_ya_key=YOUR_YANDEX_MAPS_API_KEY
# Частоты обновлений (сек)
map_upd_sec=30
map_upd_moving_sec=10
# Порог движения (метры)
map_move_threshold_m=25
# Обновление списка онлайн (сек)
map_users_refresh_idle_sec=60
map_users_refresh_moving_sec=20
# Сколько минут метка считается «живой»
map_live_time_min=60

# Яндекс.Метрика Mini App (не лендинг cabrioride.by). Локально без этой строки счётчик не грузим
YANDEX_METRIKA_ID=112389999

# Dev mode (опционально)
# DEV_MODE=1
# DEV_OVERRIDE_ROLE=admin